diff --git a/barricade/integrations/serialization.py b/barricade/integrations/serialization.py
new file mode 100644
index 0000000..dae3114
--- /dev/null
+++ b/barricade/integrations/serialization.py
@@ -0,0 +1,29 @@
+"""Serialize a CRCON integration's remote and reference mutations.
+
+The dedicated unpooled connection prevents lock waiters from exhausting the
+application's regular database pool. All replicas must run this version.
+"""
+from functools import wraps
+
+from sqlalchemy import text
+from sqlalchemy.ext.asyncio import create_async_engine
+from sqlalchemy.pool import NullPool
+
+from barricade.constants import DB_URL
+
+lock_engine = create_async_engine(DB_URL, poolclass=NullPool)
+
+
+def serialized_integration(func):
+    @wraps(func)
+    async def wrapper(integration, *args, **kwargs):
+        if integration.config.id is None:
+            raise RuntimeError('Integration needs to be created first')
+        async with integration.lock:
+            async with lock_engine.begin() as connection:
+                await connection.execute(
+                    text("SELECT pg_advisory_xact_lock(hashtextextended(:key, 0))"),
+                    {'key': f'barricade-integration:{integration.config.id}'},
+                )
+                return await func(integration, *args, **kwargs)
+    return wrapper
