{
  "name": "rcongui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "",
    "copy-assets": "node scripts/copy-assets.mjs",
    "start": "vite",
    "dev": "vite dev",
    "dev:fake": "npm run copy-assets && vite dev --mode fake",
    "dev:debug": "DEBUG=true vite dev",
    "dev:public": "REACT_APP_PUBLIC_BUILD=true vite dev",
    "build": "vite build",
    "build:public": "REACT_APP_PUBLIC_BUILD=true vite build",
    "demo": "NODE_ENV=development vite build && vite preview --host",
    "serve": "vite preview",
    "preview": "vite build && vite preview",
    "preview:debug": "DEBUG=true vite build && vite preview",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:headed": "playwright test --headed",
    "check:bundle": "node scripts/check-initial-bundle-budget.mjs",
    "check:i18n": "node scripts/check-i18n-contract.mjs && node --test src/hooks/edit-account-copy.test.mjs src/i18n/operator-messages.test.mjs src/i18n/date-locale.test.mjs src/i18n/fr-autobalancer.test.mjs src/i18n/fr-core.test.mjs src/i18n/fr-actions.test.mjs src/i18n/fr-balance.test.mjs src/i18n/fr-discord-reports.test.mjs src/i18n/fr-settings-safety.test.mjs src/i18n/fr-settings-remaining.test.mjs src/i18n/fr-campaigns.test.mjs src/i18n/fr-navigation-maps.test.mjs src/i18n/fr-account-interface.test.mjs src/i18n/french-catalog-draft.test.mjs src/pages/documentation/content-fr.test.mjs src/pages/settings/vip-rewards/copy-fr.test.mjs src/pages/settings/config-form/simulation-copy-fr.test.mjs src/pages/settings/report-admin/copy-fr.test.mjs src/pages/settings/leadership-votes/copy-fr.test.mjs src/pages/settings/maps/workbench-fr.test.mjs src/pages/settings/end-match-stats/french.test.mjs src/pages/settings/settings-english.test.mjs src/pages/views/live-map/copy-fr.test.mjs src/pages/views/team/live-views-localization.test.mjs ../rcongui_public/src/i18n/french-catalog.test.mjs",
    "check:game-capabilities": "node scripts/check-game-timer-capabilities.mjs",
    "check:admin-actions": "node scripts/check-admin-action-contract.mjs",
    "check:permissions": "node --check ../rconweb/static/api/js/permission-picker.js && node --check ../rconweb/static/api/js/permission-wizard.js && node --test ../rconweb/static/api/js/permission-planner.test.cjs ../rconweb/static/api/js/permission-fr.test.cjs",
    "check:csrf": "node scripts/check-csrf-request-contract.mjs && node --test src/utils/csrfTransport.test.mjs src/pages/account/password-client.test.mjs",
    "check:operator-copy": "node scripts/check-operator-copy.mjs",
    "check:config-compatibility": "node scripts/check-config-form-compatibility.mjs",
    "check:polling": "node scripts/check-polling-budget.mjs",
    "check:teamkill-risk": "node scripts/check-teamkill-risk.mjs",
    "check:player-warnings": "node --test src/utils/player-warnings.test.mjs",
    "check:player-identities": "node --test src/utils/player-identity.test.mjs",
    "check:design-foundation": "node scripts/check-design-foundation.mjs",
    "check:page-semantics": "node scripts/check-page-semantics.mjs",
    "check:action-feedback": "node scripts/check-action-feedback.mjs",
    "check:navigation-shell": "node scripts/check-navigation-shell.mjs",
    "check:config-workbench": "node scripts/check-configuration-workbench.mjs",
    "check:communication-workbench": "node scripts/check-communication-workbench.mjs",
    "check:history-workbench": "node scripts/check-history-workbench.mjs",
    "check:live-balance": "node scripts/check-live-balance-assistant.mjs && node --test src/pages/views/team/balance-recommendations.test.mjs",
    "check:log-stacks": "node --test src/pages/views/live/log-stacks.test.mjs",
    "check:live-view": "node --test src/pages/views/live/live-view-preferences.test.mjs",
    "check:color-vision": "node scripts/check-color-vision-contract.mjs",
    "format:write": "prettier src/ --write",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@fontsource/montserrat": "^5.1.0",
    "@fontsource/roboto": "^5.0.14",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@jsonforms/core": "^3.4.1",
    "@jsonforms/material-renderers": "^3.4.1",
    "@jsonforms/react": "^3.4.1",
    "@monaco-editor/react": "^4.2.2",
    "@mui/icons-material": "^6.4.3",
    "@mui/lab": "^6.0.0-beta.9",
    "@mui/material": "^6.4.3",
    "@mui/styles": "^6.4.3",
    "@mui/system": "^6.4.3",
    "@mui/x-charts": "^7.16.0",
    "@mui/x-data-grid": "^7.16.0",
    "@mui/x-date-pickers": "^7.16.0",
    "@tanstack/react-query": "^5.55.0",
    "@tanstack/react-query-devtools": "^5.59.15",
    "@tanstack/react-table": "^8.20.5",
    "chart.js": "^3.9.1",
    "country-list": "^2.2.0",
    "dayjs": "^1.11.10",
    "emoji-mart": "^5.6.0",
    "google-palette": "^1.1.0",
    "i18next": "24.0.5",
    "i18next-browser-languagedetector": "8.0.1",
    "immutable": "^5.1.8",
    "iso-639-1": "^3.1.5",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "moment": "^2.29.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^4.0.0",
    "react-code-blocks": "^0.1.6",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "15.1.3",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.4",
    "react-toastify": "^11.0.5",
    "react-window": "^1.8.10",
    "remark-gfm": "^4.0.0",
    "tiny-invariant": "^1.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^9.4.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.3.2",
    "@testing-library/user-event": "^7.1.2",
    "@types/lodash": "^4.17.13",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.0.3",
    "miragejs": "^0.1.48",
    "prettier": "^2.8.8",
    "vite": "^8.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
