ARG buildImage=node:20-bookworm-slim
ARG CRCON_VERSION=unknown

FROM $buildImage AS adminbuild

ARG CRCON_VERSION

RUN apt update && apt install -y git

WORKDIR /code

COPY rcongui/ .
RUN npm ci
ENV REACT_APP_API_URL=/api/
ENV REACT_APP_VERSION=$CRCON_VERSION
COPY assets/images/ /code/public
COPY assets/rcongui/ /code/public
RUN printf '%s\n' "$CRCON_VERSION" > /code/tag_version
RUN npx browserslist@latest --update-db
RUN npm run build
RUN mv /code/dist /www

FROM $buildImage AS publicbuild

WORKDIR /code_public

COPY rcongui_public/ .
RUN npm ci
COPY assets/images/ /code_public/public
COPY assets/rcongui_public/ /code_public/public
RUN npm run build
RUN mv /code_public/dist /www_public

FROM nginx:mainline-alpine

RUN apk add --no-cache openssl
# Each frontend serves one CRCON instance. A single event-driven Nginx worker
# is sufficient and avoids multiplying idle processes by the host CPU count.
RUN sed -i 's/^worker_processes[[:space:]]\+auto;/worker_processes 1;/' /etc/nginx/nginx.conf
COPY rcongui/nginx.conf /etc/nginx/conf.d/default.conf

WORKDIR /var/www

RUN mkdir /var/www_public/
COPY --from=publicbuild /www_public /var/www_public/
COPY --from=adminbuild /www /var/www/
COPY --from=adminbuild /code/tag_version /code/tag_version

VOLUME /certs
COPY rcongui/entrypoint.sh /code/entrypoint.sh
RUN chmod +x /code/entrypoint.sh

ENTRYPOINT [ "/code/entrypoint.sh" ]
